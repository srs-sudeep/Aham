# Copy to services/<name>/.env (monorepo) or .env (polyrepo). Never commit real .env files.
ENV=dev
LOG_LEVEL=INFO
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/<service_package>
# JWKS_URL=https://login.example.com/.well-known/jwks.json   # real auth; leave unset for dev tokens
# JWT_AUDIENCE=api://{{ project_slug }}
# SERVICE_URLS={"orders": "http://localhost:8002"}
# OTEL_ENABLED=true
{%- if messaging == 'kafka' %}
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
{%- endif %}
