{%- macro kit_access() %}{% if repo_layout == 'polyrepo_service' %}
      - uses: webfactory/ssh-agent@v0.9.0   # read access to the private platform-kit repo (docker build)
        with: { ssh-private-key: "{% raw %}${{ secrets.PLATFORM_KIT_DEPLOY_KEY }}{% endraw %}" }{% endif %}{% endmacro -%}
name: Release

# Push a semver tag (git tag v1.2.3 && git push --tags) to publish images to GHCR:
#   ghcr.io/<owner>/<repo>/<service>:1.2.3, :1.2, :sha-<short>
on:
  push:
    tags: ["v*.*.*"]

permissions:
  contents: read

concurrency:
  group: {% raw %}release-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
{%- if repo_layout == 'monorepo' %}
  plan:
    runs-on: ubuntu-latest
    outputs:
      services: {% raw %}${{ steps.list.outputs.services }}{% endraw %}
    steps:
      - uses: actions/checkout@v4
        with: { persist-credentials: false }
      - uses: astral-sh/setup-uv@v5
        with: { enable-cache: true }
      - run: uv sync --all-packages
      - id: list
        run: echo "services=$(uv run dx services --json)" >> "$GITHUB_OUTPUT"

  image:
    needs: plan
    if: needs.plan.outputs.services != '[]'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        service: {% raw %}${{ fromJson(needs.plan.outputs.services) }}{% endraw %}
    steps:
      - uses: actions/checkout@v4
        with: { persist-credentials: false }
      - name: Validate service name
        env:
          SERVICE: {% raw %}${{ matrix.service }}{% endraw %}
        run: |
          if [[ ! "$SERVICE" =~ ^[a-z][a-z0-9-]*$ ]]; then
            echo "Invalid service name: $SERVICE" >&2
            exit 1
          fi
          echo "DOCKERFILE=services/$SERVICE/Dockerfile" >> "$GITHUB_ENV"
          echo "IMAGE=ghcr.io/${GITHUB_REPOSITORY,,}/$SERVICE" >> "$GITHUB_ENV"
{%- else %}
  image:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4
        with: { persist-credentials: false }
      - name: Image name
        run: |
          echo "DOCKERFILE=Dockerfile" >> "$GITHUB_ENV"
          echo "IMAGE=ghcr.io/${GITHUB_REPOSITORY,,}" >> "$GITHUB_ENV"
{%- endif %}
      - uses: docker/setup-buildx-action@v3
{{- kit_access() }}
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - id: meta
        uses: docker/metadata-action@v5
        with:
          images: {% raw %}${{ env.IMAGE }}{% endraw %}
          tags: |
            type=semver,pattern={% raw %}{{version}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}.{{minor}}{% endraw %}
            type=sha
      - uses: docker/build-push-action@v6
        with:
          context: .
          file: {% raw %}${{ env.DOCKERFILE }}{% endraw %}
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          provenance: true
          sbom: true
{%- if repo_layout == 'polyrepo_service' %}
          ssh: default
{%- endif %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
