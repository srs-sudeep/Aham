{
  "name": "{{ project_slug }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @{{ project_slug }}/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dx": "pnpm --filter @aham/ui-kit dx",
    "check": "pnpm dx check",
    "new-module": "pnpm dx new-module",
    "new-feature": "pnpm dx new-feature",
    "gen-api": "pnpm dx gen-api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
