import { useEffect, useState, type ReactNode } from "react";
import { I18nextProvider } from "react-i18next";
import {
  ApiProvider,
  AppQueryProvider,
  AuthProvider,
  PreferencesProvider,
  TenantProvider,
  Toaster,
  createQueryClient,
  usePreferences,
  useTenant,
} from "@aham/ui-kit";
import type { Locale, Tenant } from "@aham/ui-kit";
import { apiClient } from "../lib/api";
import { i18n } from "../lib/i18n";

/** Dev tenants. Replace with tenants resolved from the signed-in principal. */
export const DEV_TENANTS: Tenant[] = [
  { id: "acme", name: "Acme" },
  { id: "globex", name: "Globex" },
];

/**
 * The single place where the i18n language follows the stored preference.
 * Pages (e.g. Settings) only call `setLocale`; they never touch i18n directly.
 */
function LocaleSync() {
  const { locale } = usePreferences();
  useEffect(() => {
    if (i18n.language !== locale) void i18n.changeLanguage(locale);
  }, [locale]);
  return null;
}

/** Feeds the active tenant into the API context (must sit under TenantProvider). */
function TenantApiBridge({ children }: { children: ReactNode }) {
  const { tenantId } = useTenant();
  return (
    <ApiProvider client={apiClient} tenantId={tenantId}>
      {children}
    </ApiProvider>
  );
}

export function AppProviders({
  defaultLocale = "{{ default_locale }}" as Locale,
  children,
}: {
  defaultLocale?: Locale;
  children: ReactNode;
}) {
  const [queryClient] = useState(() => createQueryClient());

  return (
    <PreferencesProvider defaultLocale={defaultLocale}>
      <I18nextProvider i18n={i18n}>
        <LocaleSync />
        <AuthProvider>
          <TenantProvider
            tenants={DEV_TENANTS}
            onTenantChange={() => {
              queryClient.clear();
            }}
          >
            <TenantApiBridge>
              <AppQueryProvider client={queryClient}>
                {children}
                <Toaster />
              </AppQueryProvider>
            </TenantApiBridge>
          </TenantProvider>
        </AuthProvider>
      </I18nextProvider>
    </PreferencesProvider>
  );
}
