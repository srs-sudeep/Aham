import { useEffect, useState, type ReactNode } from "react";
import { I18nextProvider } from "react-i18next";
import { useQuery, type QueryClient } from "@tanstack/react-query";
import {
  ApiProvider,
  AppQueryProvider,
  AuthProvider,
  PreferencesProvider,
  Skeleton,
  TenantProvider,
  Toaster,
  createQueryClient,
  setStoredTenantId,
  useAuth,
  usePreferences,
  useTenant,
} from "@aham/ui-kit";
import type { Locale, Tenant } from "@aham/ui-kit";
import { AUTH_MODE, apiClient } from "../lib/api";
import { listTenants, logoutRemote, switchTenant } from "../lib/auth";
import { i18n } from "../lib/i18n";

/** Mock tenants for `VITE_AUTH_MODE=dev` (MSW scopes data per tenant). */
export const DEV_TENANTS: Tenant[] = [
  { id: "acme", name: "Acme" },
  { id: "globex", name: "Globex" },
];

/**
 * The single place where the i18n language follows the stored preference.
 * Pages (e.g. Settings) only call `setLocale`; they never touch i18n directly.
 */
function LocaleSync() {
  const { locale } = usePreferences();
  useEffect(() => {
    if (i18n.language !== locale) void i18n.changeLanguage(locale);
  }, [locale]);
  return null;
}

/** Feeds the active tenant into the API context (must sit under TenantProvider). */
function TenantApiBridge({ children }: { children: ReactNode }) {
  const { tenantId } = useTenant();
  return (
    <ApiProvider client={apiClient} tenantId={tenantId}>
      {children}
    </ApiProvider>
  );
}

/**
 * Tenants come from the signed-in principal. In `saas` mode the token's `tid` is the
 * active tenant; switching re-issues the token, then tenant-scoped caches are dropped.
 */
function TenantGate({ queryClient, children }: { queryClient: QueryClient; children: ReactNode }) {
  const { principal } = useAuth();
  const saas = AUTH_MODE === "saas";
  const activeTenantId = principal?.tenantId ?? null;
  // Bumped when a switch fails so the switcher remounts on the token's tenant again.
  const [epoch, setEpoch] = useState(0);
  if (saas) setStoredTenantId(activeTenantId);
  const tenantsQuery = useQuery({
    queryKey: ["auth", "tenants", principal?.id ?? null],
    queryFn: listTenants,
    enabled: saas && Boolean(principal),
    staleTime: 5 * 60_000,
  });

  if (saas && principal && tenantsQuery.isPending) {
    return <Skeleton className="m-6 h-32" />;
  }

  let tenants: Tenant[] = [];
  if (!saas) tenants = DEV_TENANTS;
  else if (tenantsQuery.data) tenants = tenantsQuery.data;
  else if (activeTenantId) tenants = [{ id: activeTenantId, name: activeTenantId }];

  return (
    <TenantProvider
      key={saas ? `${activeTenantId ?? "none"}:${epoch}` : "dev"}
      tenants={tenants}
      defaultTenantId={activeTenantId}
      onTenantChange={(next) => {
        if (!saas) {
          queryClient.clear();
          return;
        }
        void switchTenant(next).then(
          () => queryClient.removeQueries({ predicate: (q) => q.queryKey[0] !== "auth" }),
          () => {
            setStoredTenantId(activeTenantId);
            setEpoch((n) => n + 1);
          },
        );
      }}
    >
      <TenantApiBridge>{children}</TenantApiBridge>
    </TenantProvider>
  );
}

export function AppProviders({
  defaultLocale = "{{ default_locale }}" as Locale,
  children,
}: {
  defaultLocale?: Locale;
  children: ReactNode;
}) {
  const [queryClient] = useState(() => createQueryClient());

  return (
    <PreferencesProvider defaultLocale={defaultLocale}>
      <I18nextProvider i18n={i18n}>
        <LocaleSync />
        <AuthProvider
          onLogout={async () => {
            queryClient.clear();
            await logoutRemote();
          }}
        >
          <AppQueryProvider client={queryClient}>
            <TenantGate queryClient={queryClient}>
              {children}
              <Toaster />
            </TenantGate>
          </AppQueryProvider>
        </AuthProvider>
      </I18nextProvider>
    </PreferencesProvider>
  );
}
