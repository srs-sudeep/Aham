# Production-like SPA container on http://localhost:8080 (`docker compose up --build`).
# Day-to-day UI work uses `pnpm dev` (Vite on :5173); the backend repo runs its own compose stack.
name: {{ project_slug }}-web

services:
  web:
    build:
      context: .
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-{{ api_base_url }}}
        VITE_AUTH_MODE: ${VITE_AUTH_MODE:-{{ auth_mode }}}
        VITE_DEFAULT_LOCALE: ${VITE_DEFAULT_LOCALE:-{{ default_locale }}}
    image: ${REGISTRY:-local}/{{ project_slug }}-web:${TAG:-dev}
    ports: ["8080:8080"]
    restart: unless-stopped
