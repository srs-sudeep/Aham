{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "DX_HOOK_FILE=\"$CLAUDE_TOOL_INPUT_FILE_PATH\" pnpm dx hook pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dx hook post"
          }
        ]
      }
    ]
  }
}
