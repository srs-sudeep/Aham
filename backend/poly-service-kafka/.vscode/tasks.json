{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dx: watch structure",
      "detail": "Live architecture/RBAC checks in the Problems panel (starts when the folder opens)",
      "type": "shell",
      "command": "uv run dx watch",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "dx",
        "source": "dx",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": { "regexp": "^(.+?):(\\d+):(\\d+): ([A-Z]+\\d+) (.*)$", "file": 1, "line": 2, "column": 3, "code": 4, "message": 5 },
        "background": { "activeBegins": "^dx-watch: start", "activeEnds": "^dx-watch: done" }
      }
    },
    { "label": "dx: lint", "type": "shell", "command": "uv run dx lint", "problemMatcher": [] },
    { "label": "dx: test", "type": "shell", "command": "uv run dx test", "group": "test", "problemMatcher": [] }
  ]
}
