# Merged with the root compose.yaml by `dx up`. Paths are relative to the repository root.
services:
  $service:
    build:
      context: .
      dockerfile: $dockerfile_path
    image: $${REGISTRY:-local}/$project_slug-$service:$${TAG:-dev}
    env_file:
      - path: $service_dir_prefix.env
        required: false
    environment:
      SERVICE_NAME: $service
      ENV: $${ENV:-dev}
      DATABASE_URL: postgresql+asyncpg://app:app@postgres:5432/$package
      SERVICE_URLS: '$${SERVICE_URLS:-{}}'
      KAFKA_ENABLED: "$kafka_enabled"
      KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      OTEL_ENDPOINT: http://jaeger:4317$saas_env
    ports:
      - "$port:8000"
    depends_on:
      postgres:
        condition: service_healthy$kafka_depends$saas_depends
    restart: unless-stopped
