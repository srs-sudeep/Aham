"""Billing HTTP endpoints."""

from __future__ import annotations

from fastapi import Request
from fastapi.responses import PlainTextResponse

from $package.modules.billing.dependencies import BillingServiceDep
from $package.modules.billing.schemas import (
    ActivateSubscriptionRequest,
    CheckoutRequest,
    CheckoutResponse,
    OverrideRequest,
    PlanOut,
    SubscriptionOut,
)
from $package.permissions import Resource
from platform_kit import PUBLIC, Action, Permission, SecureRouter
from platform_kit.tenancy import PlatformOperatorDep, TenantIdDep

router = SecureRouter(prefix="/billing", tags=["billing"])


@router.get("/plans", permission=Permission(Resource.BILLING_PLAN, Action.LIST), summary="List plans")
async def list_plans(svc: BillingServiceDep) -> list[PlanOut]:
    return await svc.list_plans()


@router.get(
    "/subscription",
    permission=Permission(Resource.BILLING_SUBSCRIPTION, Action.READ),
    summary="Current tenant subscription",
)
async def get_subscription(svc: BillingServiceDep, tenant_id: TenantIdDep) -> SubscriptionOut:
    return await svc.get_subscription(tenant_id)


@router.post(
    "/subscription/activate",
    permission=Permission(Resource.BILLING_SUBSCRIPTION, Action.UPDATE),
    summary="Operator: activate or change a tenant's plan (ManualProvider)",
)
async def activate(
    body: ActivateSubscriptionRequest, svc: BillingServiceDep, _operator: PlatformOperatorDep
) -> SubscriptionOut:
    return await svc.activate(body.tenant_id, body.plan_code)


@router.post(
    "/subscription/past-due",
    permission=Permission(Resource.BILLING_SUBSCRIPTION, Action.UPDATE),
    summary="Operator: mark a tenant's subscription past_due with grace",
)
async def past_due(
    body: ActivateSubscriptionRequest, svc: BillingServiceDep, _operator: PlatformOperatorDep
) -> SubscriptionOut:
    return await svc.mark_past_due(body.tenant_id, grace_days=body.grace_days)


@router.post(
    "/subscription/cancel",
    permission=Permission(Resource.BILLING_SUBSCRIPTION, Action.DELETE),
    summary="Cancel the current tenant's subscription",
)
async def cancel(svc: BillingServiceDep, tenant_id: TenantIdDep) -> SubscriptionOut:
    return await svc.cancel(tenant_id)


@router.post(
    "/overrides",
    permission=Permission(Resource.BILLING_SUBSCRIPTION, Action.UPDATE),
    summary="Operator: sales/support entitlement override",
    status_code=201,
)
async def override(body: OverrideRequest, svc: BillingServiceDep, _operator: PlatformOperatorDep) -> SubscriptionOut:
    return await svc.set_override(body)


@router.post(
    "/checkout",
    permission=Permission(Resource.BILLING_SUBSCRIPTION, Action.CREATE),
    summary="Create checkout session (optional Stripe — requires platform-kit[stripe] + STRIPE_*)",
)
async def checkout(body: CheckoutRequest, svc: BillingServiceDep, tenant_id: TenantIdDep) -> CheckoutResponse:
    url = await svc.create_checkout(tenant_id, body.plan_code)
    return CheckoutResponse(checkout_url=url)


@router.post(
    "/webhooks/stripe",
    permission=PUBLIC,
    summary="Stripe webhook (no-op unless Stripe is configured)",
)
async def stripe_webhook(request: Request, svc: BillingServiceDep) -> PlainTextResponse:
    body = await request.body()
    await svc.handle_stripe_webhook(dict(request.headers), body)
    return PlainTextResponse("ok")
