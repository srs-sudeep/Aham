"""Domain errors. `message` is shown to users; pass `detail=` for developers."""

from platform_kit import ConflictError, NotFoundError


class ItemNotFoundError(NotFoundError):
    code = "item_not_found"
    message = "Item not found."


class ItemNameTakenError(ConflictError):
    code = "item_name_taken"
    message = "An item with this name already exists."


class ItemSkuTakenError(ConflictError):
    code = "item_sku_taken"
    message = "An item with this SKU already exists."


class ItemCategoryNotFoundError(NotFoundError):
    code = "item_category_not_found"
    message = "Category not found in this tenant."
