{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run dx check:*)",
      "Bash(uv run dx rules)",
      "Bash(uv run dx services:*)",
      "Bash(uv run dx lint:*)",
      "Bash(uv run dx test:*)",
      "Bash(uv run dx fmt)",
      "Bash(uv run dx new-module:*)",
      "Bash(uv run dx new-service:*)",
      "Bash(uv run dx permissions:*)",
      "Bash(uv run dx token:*)",
      "Bash(uv run dx openapi:*)",
      "Bash(uv run dx db:*)",
      "Bash(uv run dx up:*)",
      "Bash(uv run dx down)",
      "Bash(uv run dx logs:*)",
      "Bash(uv run dx run:*)",
      "Bash(uv run dx watch:*)",
      "Bash(uv run dx affected:*)",
      "Bash(uv run dx hook:*)",
      "Bash(uv run pyright:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.*)",
      "Bash(git push:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv run dx down --volumes:*)",
      "Bash(uv run dx db downgrade:*)",
      "Edit(./packages/platform-kit/**)",
      "Edit(./packages/contracts/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.cursor/**)",
      "Edit(./pyproject.toml)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.pre-commit-config.yaml)",
      "Write(./.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet dx hook claude-pre", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet dx hook claude-post", "timeout": 60 }]
      }
    ]
  }
}
